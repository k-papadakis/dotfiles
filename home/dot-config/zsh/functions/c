# vim: filetype=zsh
c() {
  local model
  model=$(printf '%s\n' fable opus sonnet haiku | fzf --prompt='model> ' --height=~50%) || return

  local mode
  case "$model" in
  haiku)
    mode=manual
    ;;
  *)
    mode=$(printf '%s\n' plan auto | fzf --prompt='mode> ' --height=~50%) || return
    ;;
  esac

  claude --model "$model" --permission-mode "$mode" "$@"
}

{
  "$schema": "https://opencode.ai/v2/cli.json",
  "prompt": {
    "paste": "full",
    "image_preview": true
  },
  "session": {
    "thinking": "show"
  },
  "tabs": {
    "indicators": "numbers"
  },
  "keybinds": {
    "command.palette.show": "<leader>p",
    "input.submit": "return,ctrl+m",
    "input.backspace": "backspace,shift+backspace,ctrl+h",
    "prompt.history.previous": "up,ctrl+p",
    "prompt.history.next": "down,ctrl+n"
  },
  "attention": {
    "notifications": true,
    "sound": true
  }
}
